#!/usr/bin/python3 -u
"""Carries the remote desktop's audio between PulseAudio and browsers.

Playback: FreeRDP plays the remote desktop's audio into the "rdp" null sink;
every connected browser gets its monitor as binary messages of raw PCM
(s16le, 48 kHz, stereo, 20 ms each). Silent chunks are not sent, so an idle
desktop costs no bandwidth.

Microphone (MIC=on): browsers send binary messages of raw PCM (s16le, 48 kHz,
mono), which are played into the "mic" null sink. FreeRDP records its monitor
as the remote desktop's microphone.

The first message to each browser is a text message with the settings, e.g.
{"mic": true}. vdi-audio.js in the web client is the other end.

The expected Authorization header ("Basic ..." or an empty line for none) is
read from stdin so the KasmVNC password never appears in argv or environ.
"""
import asyncio
import hmac
import http
import json
import logging
import os
import sys
from urllib.parse import urlsplit

import websockets

PORT = int(os.environ.get("AUDIO_PORT", "8081"))
MIC = os.environ.get("MIC", "off") == "on"
RATE = 48000
CHUNK = RATE // 50 * 2 * 2  # 20 ms of stereo s16le
SILENCE = bytes(CHUNK)

expected_auth = sys.stdin.readline().strip()


def hostname(netloc):
    return urlsplit("//" + netloc).hostname


async def check_request(path, headers):
    if expected_auth and not hmac.compare_digest(
        headers.get("Authorization", "").encode(), expected_auth.encode()
    ):
        return http.HTTPStatus.UNAUTHORIZED, [], b""
    # Browsers send cached basic auth credentials with cross-site WebSocket
    # handshakes too, so only accept pages served from this host.
    origin = headers.get("Origin")
    if origin and urlsplit(origin).hostname != hostname(headers.get("Host", "")):
        return http.HTTPStatus.FORBIDDEN, [], b""
    return None


async def stop(proc):
    if proc is not None and proc.returncode is None:
        proc.kill()
        await proc.wait()


async def play(ws):
    """Send the rdp sink's monitor to the browser."""
    proc = await asyncio.create_subprocess_exec(
        "parec", "--device=rdp.monitor", "--raw", "--format=s16le",
        f"--rate={RATE}", "--channels=2", "--latency-msec=20",
        stdin=asyncio.subprocess.DEVNULL, stdout=asyncio.subprocess.PIPE,
    )
    try:
        while True:
            data = await proc.stdout.readexactly(CHUNK)
            if data != SILENCE:
                await ws.send(data)
    except asyncio.IncompleteReadError:
        print(f"parec exited (code {await proc.wait()})", flush=True)
    finally:
        await stop(proc)


async def record(ws):
    """Play the browser's microphone into the mic sink. Also notices the
    browser disconnecting, whether or not it sends anything."""
    proc = None
    try:
        async for msg in ws:
            if not MIC or not isinstance(msg, bytes):
                continue
            if proc is None:
                proc = await asyncio.create_subprocess_exec(
                    "pacat", "--playback", "--device=mic", "--raw",
                    "--format=s16le", f"--rate={RATE}", "--channels=1",
                    "--latency-msec=60",
                    stdin=asyncio.subprocess.PIPE,
                    stdout=asyncio.subprocess.DEVNULL,
                )
                print("microphone stream started", flush=True)
            proc.stdin.write(msg)
            await proc.stdin.drain()
    finally:
        await stop(proc)


async def handle(ws, path=None):
    print("client connected", flush=True)
    await ws.send(json.dumps({"mic": MIC}))
    tasks = [asyncio.create_task(play(ws)), asyncio.create_task(record(ws))]
    done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
    for task in pending:
        task.cancel()
    await asyncio.gather(*pending, return_exceptions=True)
    for task in done:
        exc = task.exception()
        if exc and not isinstance(exc, websockets.ConnectionClosed):
            print(f"error: {exc!r}", flush=True)
    print("client disconnected", flush=True)


async def main():
    async with websockets.serve(
        handle, "0.0.0.0", PORT,
        process_request=check_request,
        compression=None,  # PCM barely compresses; deflate only costs CPU
    ):
        print(f"listening on port {PORT} (microphone {'on' if MIC else 'off'})",
              flush=True)
        await asyncio.Future()


logging.basicConfig(level=logging.WARNING, format="%(message)s")
asyncio.run(main())
