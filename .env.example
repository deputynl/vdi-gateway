# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# docker compose reads .env automatically. Don't commit the real .env.

# --- Required ---------------------------------------------------------------
# RDP host (VM hostname or IP; IPv6 literals in brackets, e.g. [fd00::10])
TARGET_HOST=gnome-vm.lan
# GNOME Remote Desktop *system* credentials (sudo grdctl --system rdp set-credentials ...)
RDP_USERNAME=rdp-system-user
RDP_PASSWORD=change-me

# --- Optional ---------------------------------------------------------------
#TARGET_PORT=3389
#RDP_DOMAIN=

# ignore (default) or tofu (trust on first use, stored in the freerdp-config volume)
#RDP_CERT_MODE=ignore

# Layout id announced to the server: hex id or name from `xfreerdp3 /list:kbd`,
# e.g. 0x00000407 or German. The characters typed come from GNOME's own layout.
#KEYBOARD_LAYOUT=

# Extra FreeRDP arguments, whitespace-separated (no quoting), e.g. /log-level:INFO
#FREERDP_EXTRA_ARGS=

# KasmVNC basic auth. Leave KASM_PASSWORD unset to disable auth; only do that
# when the container is reachable solely through an authenticating reverse proxy.
# Generate a password with: openssl rand -base64 24
# Header for the proxy: printf 'kasm:%s' "$KASM_PASSWORD" | base64 -w0
#KASM_USER=kasm
#KASM_PASSWORD=

# Remote desktop audio in the browser: on (default) or off. Needs the reverse
# proxy to route /vdi-audio to port 8081 (see README).
#AUDIO=on
# Microphone from the browser (toggle button in the page, off until clicked):
# on (default) or off. Only works with AUDIO=on.
#MIC=on
